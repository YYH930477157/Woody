# Enforce Unix-style line endings
* text=auto eol=lf

# Deny checkout of files with mixed line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.patch text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Preserve upstream redistribution notices verbatim.
resources/bundled-mcp/codebase-memory/LICENSE -text -whitespace
resources/bundled-mcp/codebase-memory/THIRD_PARTY_NOTICES.md -text -whitespace
