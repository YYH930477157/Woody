From 47aca62287e7318b38d22b213a058e23094d8be5 Mon Sep 17 00:00:00 2001
From: YYH930477157 <yyh930477157@gmail.com>
Date: Fri, 23 Oct 2026 18:20:09 +0800
Subject: [PATCH] fix(scm): discover hidden child repositories

Workspace discovery skipped every dot-prefixed child directory, so a repository whose project folder started with a dot (or a checkout carrying the Windows Hidden attribute) never surfaced in the Changes panel. Skip only VCS metadata directories and keep other hidden project directories as candidates. Add regression coverage for a hidden child repository and for a root repository whose .git is hidden.
---
 crates/aionui-project/src/scm/git_provider.rs | 12 ++++---
 .../src/scm/git_provider_test.rs              | 34 +++++++++++++++----
 2 files changed, 35 insertions(+), 11 deletions(-)

diff --git a/crates/aionui-project/src/scm/git_provider.rs b/crates/aionui-project/src/scm/git_provider.rs
index 2f9c494..a7aa632 100644
--- a/crates/aionui-project/src/scm/git_provider.rs
+++ b/crates/aionui-project/src/scm/git_provider.rs
@@ -257,9 +257,11 @@ fn open_repo(path: &Path, relative_path: String) -> Result<Option<OpenedRepo>, g
 }
 
 /// Read one level of `root`'s child directories and surface each that opens as a
-/// repository. Never recurses. Skips dotfiles/hidden entries, non-directories,
+/// repository. Never recurses. Skips VCS metadata directories, non-directories,
 /// and symlinks (a symlink is not descended into — it is not a child directory
-/// of this workspace in any meaningful sense and could point anywhere).
+/// of this workspace in any meaningful sense and could point anywhere). Other
+/// hidden directories remain candidates: a checkout may carry the Windows Hidden
+/// attribute, and a project folder itself may start with a dot.
 ///
 /// A directory that fails to open as a repository is simply skipped; only a
 /// hard read error on an individual child is logged. A `read_dir` failure on the
@@ -280,8 +282,10 @@ fn discover_child_repos(root: &Path) -> Vec<OpenedRepo> {
         let Some(name) = name.to_str() else {
             continue;
         };
-        // Skip hidden entries (`.git`, `.DS_Store`, editor dirs, …).
-        if name.starts_with('.') {
+        // Skip the metadata directories themselves. Hidden *project* directories
+        // are still checked: Windows marks some checkouts hidden, and a folder
+        // whose name starts with a dot is a valid repository root.
+        if matches!(name.to_ascii_lowercase().as_str(), ".git" | ".svn" | ".hg") {
             continue;
         }
         // `file_type` does not follow symlinks, so a symlinked directory reports
diff --git a/crates/aionui-project/src/scm/git_provider_test.rs b/crates/aionui-project/src/scm/git_provider_test.rs
index eef9898..1046c0f 100644
--- a/crates/aionui-project/src/scm/git_provider_test.rs
+++ b/crates/aionui-project/src/scm/git_provider_test.rs
@@ -213,21 +213,41 @@ async fn workspace_root_that_is_itself_a_repository_does_not_scan_children() {
 }
 
 #[tokio::test]
-async fn workspace_discovery_skips_hidden_directories() {
+async fn workspace_discovery_includes_hidden_repository_directories() {
     let tmp = TempDir::new().expect("tempdir");
     init_committed_repo(&tmp.path().join("visible"));
-    // A hidden dir that is itself a repo must still be skipped.
-    init_committed_repo(&tmp.path().join(".hidden-repo"));
+    // A hidden directory that is itself a repo is still a project folder.
+    let hidden = init_committed_repo(&tmp.path().join(".hidden-repo"));
+    assert!(hidden.workdir().is_some());
 
     let provider = GitScmProvider::new();
     let root = workspace_root_at("ws", tmp.path(), "workspace");
     let repos = provider.discover(&root).await.expect("discover ok");
 
-    assert_eq!(
-        child_names(&repos),
-        vec!["visible".to_owned()],
-        "dot-directories are skipped"
+    assert_eq!(by_child(&repos, "visible").root.relative_path, "visible");
+    assert_eq!(by_child(&repos, ".hidden-repo").root.relative_path, ".hidden-repo");
+    assert_eq!(repos.len(), 2, "hidden repositories are candidates too");
+}
+
+#[tokio::test]
+#[cfg(windows)]
+async fn root_repository_with_hidden_git_directory_is_discovered() {
+    let tmp = TempDir::new().expect("tempdir");
+    init_committed_repo(tmp.path());
+    let git = tmp.path().join(".git");
+    assert!(
+        std::process::Command::new("attrib")
+            .args(["+h", git.to_str().expect("utf8 git path")])
+            .status()
+            .expect("run attrib")
+            .success()
     );
+
+    let provider = GitScmProvider::new();
+    let root = root_at("pe1", tmp.path(), "fixture");
+    let repos = provider.discover(&root).await.expect("discover ok");
+    assert_eq!(repos.len(), 1, "a hidden .git must not hide its repository");
+    assert_eq!(repos[0].root.relative_path, "");
 }
 
 #[tokio::test]
